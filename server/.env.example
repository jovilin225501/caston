# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# In development, leave empty to automatically use in-memory MongoDB fallback
# For production, supply your MongoDB Atlas URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=campusconnect_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=7d

# CORS Allowed Origins (comma-separated or single domain)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials (used by seed script or auto-init)
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campusconnect.edu
ADMIN_PASSWORD=Admin@Campus2026!
